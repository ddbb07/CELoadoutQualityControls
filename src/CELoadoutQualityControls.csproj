<Project>

	<PropertyGroup>
		<RimWorldVersions>1.6</RimWorldVersions>
		<_RimWorldDispatch Condition="'$(RimWorldVersion)' == ''">true</_RimWorldDispatch>
		<RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
		<BaseIntermediateOutputPath>obj/$(RimWorldVersion)/</BaseIntermediateOutputPath>
		<BaseOutputPath>bin/$(RimWorldVersion)/</BaseOutputPath>
	</PropertyGroup>

	<Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

	<PropertyGroup Condition="'$(RimWorldVersion)' == '1.6'">
		<TargetFramework>net472</TargetFramework>
		<RimWorldRefVersion>1.6.4871</RimWorldRefVersion>
		<CombatExtendedVersion>1.6.7.4.0</CombatExtendedVersion>
		<CombatExtendedSha256>29b75a55bfb2935ba4cbe85a0cb312490f4a100c1dd1d2e59bce31ef3d0df35a</CombatExtendedSha256>
	</PropertyGroup>

	<PropertyGroup>
		<LangVersion>14</LangVersion>
		<DefineConstants>$(DefineConstants);RIMWORLD_$(RimWorldVersion.Replace('.', '_'))</DefineConstants>
		<DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>

		<ModDataDir>../data/</ModDataDir>
		<ModOutRoot>../out/</ModOutRoot>
		<ModOutDir>$(ModOutRoot)$(MSBuildProjectName)/</ModOutDir>
		<ModPreviewSource>../art/preview.svg</ModPreviewSource>
		<RequirePreview Condition="'$(RequirePreview)' == ''">false</RequirePreview>

		<CombatExtendedDir>$(BaseIntermediateOutputPath)CombatExtended/$(CombatExtendedVersion)/</CombatExtendedDir>
		<CombatExtendedDll>$(CombatExtendedDir)CombatExtended/Assemblies/CombatExtended.dll</CombatExtendedDll>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldRefVersion)" />
		<PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
		<Reference Include="CombatExtended" HintPath="$(CombatExtendedDll)" Private="false" />
	</ItemGroup>

	<Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

	<PropertyGroup Condition="'$(_RimWorldDispatch)' == 'true'">
		<BuildDependsOn>Package</BuildDependsOn>
	</PropertyGroup>

	<Target Name="FetchCombatExtended" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(CombatExtendedDll)')">
		<DownloadFile SourceUrl="https://github.com/CombatExtended-Continued/CombatExtended/releases/download/v$(CombatExtendedVersion)/CombatExtended-v$(CombatExtendedVersion).zip" DestinationFolder="$(CombatExtendedDir)" Retries="3">
			<Output TaskParameter="DownloadedFile" PropertyName="_CombatExtendedZip" />
		</DownloadFile>
		<VerifyFileHash File="$(_CombatExtendedZip)" Hash="$(CombatExtendedSha256)" />
		<Unzip SourceFiles="$(_CombatExtendedZip)" DestinationFolder="$(CombatExtendedDir)" Include="CombatExtended/Assemblies/CombatExtended.dll" />
		<Delete Files="$(_CombatExtendedZip)" />
	</Target>

	<Target Name="ReadModVersion" BeforeTargets="GetAssemblyVersion">
		<XmlPeek XmlInputPath="$(ModDataDir)About/About.xml" Query="/ModMetaData/modVersion/text()">
			<Output TaskParameter="Result" PropertyName="Version" />
		</XmlPeek>
		<Error Condition="'$(Version)' == ''" Text="No modVersion in $(ModDataDir)About/About.xml" />
	</Target>

	<Target Name="Package">
		<ItemGroup>
			<_RimWorldVersion Include="$(RimWorldVersions)" />
			<_RimWorldBuild Include="$(MSBuildProjectFullPath)" AdditionalProperties="RimWorldVersion=%(_RimWorldVersion.Identity)" RimWorldVersion="%(_RimWorldVersion.Identity)" />
			<_ModData Include="$(ModDataDir)**" />
		</ItemGroup>

		<MSBuild Projects="@(_RimWorldBuild)" Targets="Restore" Properties="MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
		<MSBuild Projects="@(_RimWorldBuild)" Targets="Build">
			<Output TaskParameter="TargetOutputs" ItemName="_ModAssembly" />
		</MSBuild>

		<RemoveDir Directories="$(ModOutRoot)" />
		<Copy SourceFiles="@(_ModData)" DestinationFolder="$(ModOutDir)%(RecursiveDir)" />
		<Copy SourceFiles="@(_ModAssembly)" DestinationFolder="$(ModOutDir)%(RimWorldVersion)/Assemblies/" />
	</Target>

	<Target Name="RenderPreview" AfterTargets="Package">
		<Exec Command="command -v rsvg-convert" IgnoreExitCode="true" StandardOutputImportance="low">
			<Output TaskParameter="ExitCode" PropertyName="_RsvgConvertExitCode" />
		</Exec>
		<Exec Command="fc-list -q &quot;Inter Display:medium&quot;" IgnoreExitCode="true">
			<Output TaskParameter="ExitCode" PropertyName="_InterMediumExitCode" />
		</Exec>
		<Exec Command="fc-list -q &quot;Inter Display:extrabold&quot;" IgnoreExitCode="true">
			<Output TaskParameter="ExitCode" PropertyName="_InterExtraBoldExitCode" />
		</Exec>
		<ItemGroup>
			<_PreviewProblem Include="rsvg-convert not found" Condition="'$(_RsvgConvertExitCode)' != '0'" />
			<_PreviewProblem Include="font Inter Display Medium not found" Condition="'$(_InterMediumExitCode)' != '0'" />
			<_PreviewProblem Include="font Inter Display ExtraBold not found" Condition="'$(_InterExtraBoldExitCode)' != '0'" />
		</ItemGroup>

		<Error Condition="'@(_PreviewProblem)' != '' And '$(RequirePreview)' == 'true'" Text="Can't render the preview: @(_PreviewProblem, ', ')" />
		<Warning Condition="'@(_PreviewProblem)' != '' And '$(RequirePreview)' != 'true'" Text="Building without About/Preview.png: @(_PreviewProblem, ', ')" />
		<Exec Condition="'@(_PreviewProblem)' == ''" Command="rsvg-convert &quot;$(ModPreviewSource)&quot; -o &quot;$(ModOutDir)About/Preview.png&quot;" />
	</Target>

	<Target Name="_RequirePreview">
		<PropertyGroup>
			<RequirePreview>true</RequirePreview>
		</PropertyGroup>
	</Target>

	<Target Name="Zip" DependsOnTargets="_RequirePreview;ReadModVersion;Package">
		<PropertyGroup>
			<_ModZipStageDir>$(BaseIntermediateOutputPath)zip/</_ModZipStageDir>
		</PropertyGroup>
		<ItemGroup>
			<_ModFile Include="$(ModOutDir)**" />
		</ItemGroup>

		<RemoveDir Directories="$(_ModZipStageDir)" />
		<Copy SourceFiles="@(_ModFile)" DestinationFolder="$(_ModZipStageDir)$(MSBuildProjectName)/%(RecursiveDir)" />
		<ZipDirectory SourceDirectory="$(_ModZipStageDir)" DestinationFile="$(ModOutRoot)$(MSBuildProjectName)-v$(Version).zip" Overwrite="true" />
	</Target>

</Project>
